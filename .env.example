# .env.example -- SAFE TO COMMIT. Copy to .env.local and fill real values.
# Never put real production secrets in this file or in git.

# Server-only (NO VITE_ prefix -- never exposed to the browser bundle)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Client-side (VITE_ prefix -- exposed to the browser bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
